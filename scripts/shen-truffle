#!/usr/bin/env bash
# Launch the assembled shen-truffle distribution, or the Maven classes tree
# while developing.  Keep this wrapper free of machine-specific GraalVM paths:
# use JAVA_HOME (or JAVACMD) to select the JVM.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
DIST="$ROOT/target/shen-truffle"

if [[ -n "${JAVACMD:-}" ]]; then
  JAVA="$JAVACMD"
elif [[ -n "${JAVA_HOME:-}" ]]; then
  JAVA="$JAVA_HOME/bin/java"
else
  JAVA="java"
fi

# Maven assembly may provide a native launcher.  Prefer it so the same script
# works with a relocatable distribution produced by Yggdrasil.
for launcher in "$DIST/bin/shen-truffle" "$DIST/bin/shen-truffle.exe"; do
  if [[ -x "$launcher" ]]; then
    exec "$launcher" "$@"
  fi
done

for jar in "$DIST/shen-truffle.jar" "$ROOT/target/shen-truffle.jar"; do
  if [[ -f "$jar" ]]; then
    exec "$JAVA" -Xss16m --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow ${JAVA_OPTS:-} -jar "$jar" "$@"
  fi
done

# Development fallback: Maven's classes directory plus dependencies.  The
# modern build writes a classpath file when assembling; use it if available.
if [[ -f "$DIST/classpath.txt" ]]; then
  CP="$(<"$DIST/classpath.txt")"
elif [[ -d "$ROOT/target/classes" ]]; then
  CP="$ROOT/target/classes:$ROOT/target/dependency/*"
else
  echo "shen-truffle is not built; run: mvn package" >&2
  exit 127
fi

exec "$JAVA" -Xss16m --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow ${JAVA_OPTS:-} -cp "$CP" com.github.ragnard.shen.Shen "$@"
