#!/usr/bin/env bash
# Compatibility entry point for the KLambda evaluator used by development
# and Yggdrasil's shaken-image builder.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
if [[ -n "${JAVACMD:-}" ]]; then
  JAVA="$JAVACMD"
elif [[ -n "${JAVA_HOME:-}" ]]; then
  JAVA="$JAVA_HOME/bin/java"
else
  JAVA="java"
fi

for jar in "$ROOT/target/shen-truffle/lib/shen-truffle.jar" "$ROOT/target/shen-truffle.jar"; do
  if [[ -f "$jar" ]]; then
    exec "$JAVA" -Xss16m --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow ${JAVA_OPTS:-} -cp "$jar" com.github.ragnard.shen.KLambda "$@"
  fi
done
if [[ -d "$ROOT/target/classes" ]]; then
  exec "$JAVA" -Xss16m --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow ${JAVA_OPTS:-} -cp "$ROOT/target/classes:$ROOT/target/dependency/*" com.github.ragnard.shen.KLambda "$@"
fi
echo "shen-truffle is not built; run: mvn package" >&2
exit 127
